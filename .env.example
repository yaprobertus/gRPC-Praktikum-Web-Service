# Wajib untuk Vercel: gunakan POOLED connection string Neon (hostname mengandung -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
NODE_ENV=development

# true = implementasi produksi (batch query dengan DataLoader)
# false = mode demonstrasi N+1 global; header x-n-plus-one-demo juga tersedia per request.
USE_DATALOADER=true

# Origin tambahan, dipisahkan koma. Apollo Studio dan localhost selalu diizinkan.
CORS_ORIGINS=

# Lab 06: port untuk server gRPC lokal (grpc/server.js). Di Render, PORT
# sudah otomatis diisi oleh platform sehingga baris ini tidak perlu diisi.
PORT=50051
